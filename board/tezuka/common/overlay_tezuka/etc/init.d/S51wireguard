#!/bin/sh

WG_CONF="/mnt/jffs2/etc/wireguard/wg0.conf"

start() {
	printf "Starting wireguard: "
	# fw_printenv can block if the U-Boot env backing device isn't ready
	# yet at this point in boot (observed: a ~34s hang here took down the
	# whole sequential boot chain until the hardware watchdog reset the
	# board). Bound it so a slow/unavailable env device degrades to
	# "disabled" instead of hanging boot.
	if [ "$(timeout 3 fw_printenv -n wireguard_enabled 2>/dev/null)" != "1" ]; then
		echo "disabled"
		return 0
	fi
	if [ ! -f "$WG_CONF" ]; then
		echo "no config"
		return 0
	fi
	# wg-quick's own "ip -4 address add" call is immediately preceded by
	# "wg setconf" with no delay between them — on real hardware this loses
	# a race against the newly-created wg interface settling in the
	# kernel's routing/FIB state and fails with "RTNETLINK answers: Network
	# is unreachable" (confirmed: the identical commands succeed when
	# manually spaced apart by even a 1s sleep, so this isn't a config
	# issue). wg-quick's own failure path already cleanly tears the
	# interface down, so retrying from scratch is safe.
	local i
	for i in 1 2 3; do
		if timeout 15 wg-quick up "$WG_CONF" 2>/tmp/wireguard.log; then
			echo "OK"
			return 0
		fi
		sleep 1
	done
	echo "FAIL"
	cat /tmp/wireguard.log
	return 1
}

stop() {
	printf "Stopping wireguard: "
	if ip link show wg0 >/dev/null 2>&1; then
		timeout 15 wg-quick down "$WG_CONF" 2>/tmp/wireguard.log
	fi
	echo "OK"
}

restart() {
	stop
	start
}

case "$1" in
	start)
		start;;
	stop)
		stop;;
	restart)
		restart;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
esac

exit $?
