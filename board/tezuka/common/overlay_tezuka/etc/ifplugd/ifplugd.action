#!/bin/sh
ETH_IPADDR=$(fw_printenv -n ipaddr_eth 2> /dev/null)

case "$2" in
    up)
        if [ -z "$ETH_IPADDR" ] || [ "$ETH_IPADDR" = "dhcp" ]; then
          /sbin/udhcpc -i "$1" -t 15 -T 4 -n -q -x hostname:"$(hostname)"
        fi  
        ;;
    down)
        # Only a DHCP lease is dropped: "up" above does not restore a static
        # (or AP) address, so flushing it would leave eth0 without one after
        # any link loss longer than the ifplugd down delay (5 s).
        if [ -z "$ETH_IPADDR" ] || [ "$ETH_IPADDR" = "dhcp" ]; then
          /sbin/ip addr flush dev "$1"
        fi
        ;;
esac
exit 0
