diff --git a/drivers/iio/frequency/Kconfig b/drivers/iio/frequency/Kconfig
index c444e92..87c5238 100644
--- a/drivers/iio/frequency/Kconfig
+++ b/drivers/iio/frequency/Kconfig
@@ -113,6 +113,24 @@ config CF_AXI_DDS
 	  Say yes here to build support for Analog Devices DDS chip
 	  AD9122, provides direct access via sysfs.
 
+config CF_AXI_DDS_MULTICHIP
+	bool "Include chip descriptors for other AXI DDS transceivers/DACs"
+	depends on CF_AXI_DDS
+	default y
+	help
+	  cf_axi_dds's match table always carries a static chip descriptor
+	  (and, for some chips, an iio_chan_spec table) for every AXI-DDS
+	  core the driver has ever supported: AD9739A, the dual-AD9361
+	  (ad9361x2) core, AD9371, ADRV9009 (x2/x4), AD9963, AD9081,
+	  and the ADRV9002/9003/9004/9005/9006/9025 family. AD9361 and
+	  AD9364 are unconditional and unaffected by this option.
+
+	  Say N here if your platform only ever instantiates the AD9361 or
+	  AD9364 core (e.g. PlutoSDR-derived boards) to drop this otherwise
+	  dead weight from the kernel image. This is independent from the
+	  AD9122/AD9144/AD9162/AD9172/AD9783 options below, which gate their
+	  own separate per-chip driver files.
+
 config CF_AXI_DDS_AD9122
 	tristate "Analog Devices AD9122 DAC"
 	depends on CF_AXI_DDS
