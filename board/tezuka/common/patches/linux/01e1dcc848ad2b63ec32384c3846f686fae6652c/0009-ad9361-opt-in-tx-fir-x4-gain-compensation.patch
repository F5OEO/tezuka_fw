Subject: [PATCH] iio: ad9361: compensate the known SDR Console TX FIR x4

Add an opt-in DT property for LibreSDR to replace the exact 128-tap
SDR Console TX interpolation-4 profile with a compensated FIR. The
replacement has approximately twice the DC gain and a different response;
all coefficients fit the signed 16-bit hardware format.

Leave RX, TX x1/x2, other tap counts and nonmatching profiles unchanged.
Use a local copy so uploads remain unmodified and the existing hardware
readback verification checks the coefficients actually programmed.

diff --git a/drivers/iio/adc/ad9361.c b/drivers/iio/adc/ad9361.c
--- a/drivers/iio/adc/ad9361.c
+++ b/drivers/iio/adc/ad9361.c
@@ -5381,12 +5381,51 @@ static int ad9361_verify_fir_filter_coef(struct ad9361_rf_phy *phy,
 	return ret;
 }
 
+static const short sdrconsole_tx_fir_128_x4[128] = {
+	0, 0, 1, 3, 5, 3, -3, -6,
+	0, 9, 6, -8, -14, 1, 21, 13,
+	-21, -31, 7, 47, 20, -49, -57, 29,
+	91, 19, -105, -87, 81, 157, -8, -200,
+	-107, 185, 238, -89, -343, -87, 367, 315,
+	-265, -531, 20, 651, 343, -592, -747, 295,
+	1072, 245, -1170, -964, 900, 1718, -149, -2293,
+	-1150, 2404, 3073, -1610, -5953, -1326, 12778, 25643,
+	25643, 12778, -1326, -5953, -1610, 3073, 2404, -1150,
+	-2293, -149, 1718, 900, -964, -1170, 245, 1072,
+	295, -747, -592, 343, 651, 20, -531, -265,
+	315, 367, -87, -343, -89, 238, 185, -107,
+	-200, -8, 157, 81, -87, -105, 19, 91,
+	29, -57, -49, 20, 47, 7, -31, -21,
+	13, 21, 1, -14, -8, 6, 9, 0,
+	-6, -3, 3, 5, 3, 1, 0, 0
+};
+
+static const short tx_fir_128_x4_gain2[128] = {
+	-30, -54, -46, -12, 34, 66, 62, 18,
+	-46, -94, -90, -26, 68, 138, 134, 42,
+	-98, -204, -198, -64, 138, 292, 286, 96,
+	-192, -408, -400, -138, 258, 556, 550, 194,
+	-340, -744, -742, -270, 444, 988, 994, 374,
+	-576, -1308, -1330, -516, 752, 1750, 1804, 726,
+	-1000, -2402, -2530, -1060, 1398, 3496, 3812, 1690,
+	-2178, -5844, -6848, -3394, 4652, 15428, 25642, 31842,
+	31842, 25642, 15428, 4652, -3394, -6848, -5844, -2178,
+	1690, 3812, 3496, 1398, -1060, -2530, -2402, -1000,
+	726, 1804, 1750, 752, -516, -1330, -1308, -576,
+	374, 994, 988, 444, -270, -742, -744, -340,
+	194, 550, 556, 258, -138, -400, -408, -192,
+	96, 286, 292, 138, -64, -198, -204, -98,
+	42, 134, 138, 68, -26, -90, -94, -46,
+	18, 62, 66, 34, -12, -46, -54, -30
