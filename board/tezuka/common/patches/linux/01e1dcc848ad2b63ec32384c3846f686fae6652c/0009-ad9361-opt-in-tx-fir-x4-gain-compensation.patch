+
 static int ad9361_load_fir_filter_coef(struct ad9361_rf_phy *phy,
 				       enum fir_dest dest, int gain_dB,
 				       u32 ntaps, short *coef)
 {
 	struct ad9361_rf_phy_state *st = phy->state;
 	struct spi_device *spi = phy->spi;
+	short scaled_coef[128];
 	u32 val, offs = 0, fir_conf = 0, fir_enable = 0;
 	int ret;
 
@@ -5401,6 +5440,22 @@ static int ad9361_load_fir_filter_coef(struct ad9361_rf_phy *phy,
 		return -EINVAL;
 	}
 
+	/* Leave all FIR profiles except this exact SDR Console TX x4 unchanged. */
+	if (!(dest & FIR_IS_RX) && st->tx_fir_int == 4 &&
+	    ntaps == ARRAY_SIZE(sdrconsole_tx_fir_128_x4) &&
+	    of_property_read_bool(spi->dev.of_node,
+				  "adi,tx-fir-x4-gain-compensation-enable") &&
+	    !memcmp(coef, sdrconsole_tx_fir_128_x4,
+		    sizeof(sdrconsole_tx_fir_128_x4))) {
+		dev_info(&spi->dev,
+			 "SDR Console TX INT4 FIR detected, applying compensated FIR\n");
+		memcpy(scaled_coef, tx_fir_128_x4_gain2,
+		       sizeof(tx_fir_128_x4_gain2));
+
+		/* Preserve the uploaded taps; verify the replacement copy. */
+		coef = scaled_coef;
+	}
+
 	ad9361_ensm_force_state(phy, ENSM_STATE_ALERT);
 
 	if (dest & FIR_IS_RX) {
