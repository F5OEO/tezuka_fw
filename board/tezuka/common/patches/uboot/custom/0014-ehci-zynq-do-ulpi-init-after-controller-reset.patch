usb: ehci-zynq: do ULPI init in init_after_reset, not probe

ehci_zynq_probe() ran ulpi_init() plus the otg_ctrl/function_ctrl/
iface_ctrl/DRVVBUS ULPI register writes, then called ehci_register().
But ehci_register() calls ehci_reset() first, which issues a
controller HCRESET -- and that also resets the ULPI-connected PHY
interface, wiping out the ULPI setup that had just been done. By the
time ehci_common_init() enables the async schedule there is no valid
PHY link, so STS_ASS never comes up: "usb start" registers u-boot's
own root hub fine (port-level CCS/PE line-state sensing still works)
but times out ("EHCI fail timeout STS_ASS set") scanning for any real
device and finds nothing.

ehci_register() supports exactly this ordering problem via
ops->init_after_reset(), called right after HCRESET completes and
before the async schedule is brought up. ehci-mx6.c and other
ChipIdea-based EHCI drivers already do their PHY/PORTSC setup there
instead of in probe(); do the same here: move the ULPI block into a
zynq_init_after_reset() hook and register it via ehci_ops instead of
passing NULL to ehci_register().

Once that ordering bug is fixed, a bus-powered USB device attached
directly to the root port (no self-powered hub in between, which is
already enumerated and answers immediately) still fails to enumerate
on a cold boot: EHCI successfully asserts VBUS and reaches the async
schedule, but the very first control transfer times out ("EHCI timed
out on TD") or the device doesn't accept its new address. This is a
real device power-up/attach-debounce settle time, not a driver
ordering bug: the same board and stick enumerate fine once the
controller has already been running for a while (e.g. immediately
after an earlier successful probe in the same power-on session), and
fail identically regardless of the settle time inserted between "usb
stop" and a warm "usb start" retry, since VBUS/DRVVBUS is never
actually deasserted across a stop -- only a genuinely cold boot
discriminates. Tested cold on real hardware: 300ms is not enough,
1000ms enumerates reliably. Give the PHY/device a full second after
VBUS is asserted before ehci_common_init() starts scanning.

--- a/drivers/usb/host/ehci-zynq.c
+++ b/drivers/usb/host/ehci-zynq.c
@@ -12,6 +12,7 @@
 #include <asm/io.h>
 #include <usb/ehci-ci.h>
 #include <usb/ulpi.h>
+#include <linux/delay.h>
 
 #include "ehci.h"
 
@@ -31,21 +32,22 @@
 	return 0;
 }
 
-static int ehci_zynq_probe(struct udevice *dev)
+static int zynq_init_after_reset(struct ehci_ctrl *ctrl)
 {
-	struct usb_plat *plat = dev_get_plat(dev);
-	struct zynq_ehci_priv *priv = dev_get_priv(dev);
-	struct ehci_hccr *hccr;
-	struct ehci_hcor *hcor;
+	struct zynq_ehci_priv *priv =
+		container_of(ctrl, struct zynq_ehci_priv, ehcictrl);
 	struct ulpi_viewport ulpi_vp;
 	/* Used for writing the ULPI data address */
 	struct ulpi_regs *ulpi = (struct ulpi_regs *)0;
 	int ret;
 
-	hccr = (struct ehci_hccr *)((uint32_t)&priv->ehci->caplength);
-	hcor = (struct ehci_hcor *)((uint32_t) hccr +
-			HC_LENGTH(ehci_readl(&hccr->cr_capbase)));
-
+	/*
+	 * ehci_reset()'s HCRESET (called just before this hook runs) also
+	 * resets the ULPI-connected PHY interface, so this must happen
+	 * *after* the reset, not in probe() before ehci_register() -- doing
+	 * it in probe left the core with no valid PHY link once reset ran,
+	 * and the async schedule (STS_ASS) never came up.
+	 */
 	ulpi_vp.viewport_addr = (u32)&priv->ehci->ulpi_viewpoint;
 	ulpi_vp.port_num = 0;
 
@@ -68,7 +70,28 @@
 	ulpi_write(&ulpi_vp, &ulpi->otg_ctrl_set,
 		   ULPI_OTG_DRVVBUS | ULPI_OTG_DRVVBUS_EXT);
 
-	return ehci_register(dev, hccr, hcor, NULL, 0, plat->init_type);
+	mdelay(1000);
+
+	return 0;
+}
+
+static const struct ehci_ops zynq_ehci_ops = {
+	.init_after_reset = zynq_init_after_reset,
+};
+
+static int ehci_zynq_probe(struct udevice *dev)
+{
+	struct usb_plat *plat = dev_get_plat(dev);
+	struct zynq_ehci_priv *priv = dev_get_priv(dev);
+	struct ehci_hccr *hccr;
+	struct ehci_hcor *hcor;
+
+	hccr = (struct ehci_hccr *)((uint32_t)&priv->ehci->caplength);
+	hcor = (struct ehci_hcor *)((uint32_t) hccr +
+			HC_LENGTH(ehci_readl(&hccr->cr_capbase)));
+
+	return ehci_register(dev, hccr, hcor, &zynq_ehci_ops, 0,
+			      plat->init_type);
 }
 
 static const struct udevice_id ehci_zynq_ids[] = {
