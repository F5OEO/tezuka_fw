CONFIG_DEBUG_ZYNQ_UART1=y
CONFIG_MACB=y

# The shared kernel defconfig enables DRM (CONFIG_DRM=m + VGEM/VKMS) for
# fl2k-kmod (six DATV boards) and fishball7020's OLED display -- plutoplus
# has no display/DRM consumer at all (no display node in any plutoplus
# DTS, no fl2k-kmod, nothing touching /dev/dri anywhere in overlays or
# packages), so drop it here rather than in the shared file. Saves the
# drm.ko/drm_kms_helper.ko/vkms.ko/vgem.ko module set from the image.
# CONFIG_DRM is not set
# CONFIG_DRM_GEM_SHMEM_HELPER is not set
# CONFIG_DRM_VGEM is not set
# CONFIG_DRM_VKMS is not set
