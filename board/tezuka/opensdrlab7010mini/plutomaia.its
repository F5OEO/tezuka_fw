/*
 * U-Boot uImage source file with multiple kernels, ramdisks and FDT blobs
 * This example makes use of the 'loadables' field
 */

/*
 * fdt get addr foo /images/fdt@1 data
 */

/dts-v1/;

/ {
	description = "Configuration to load fpga before Kernel";
	magic = "ITB PlutoSDR (ADALM-PLUTO)";
	#address-cells = <1>;
	images {

		fdt@1 {
			description = "zynq-pluto-sdr";
			data = /incbin/("opensdrlab7010mini.dtb");
			type = "flat_dt";
			arch = "arm";
			compression = "none";
		};

		fpga@1 {
			description = "FPGA";
			data = /incbin/("system_top.bit");
			type = "fpga";
			compatible = "u-boot,fpga-legacy";
			arch = "arm";
			compression = "none";
			load = <0xF000000>;
			hash@1 {
				algo = "md5";
			};
		};

		linux_kernel@1 {
			description = "Linux";
			data = /incbin/("zImage");
			type = "kernel";
			arch = "arm";
			os = "linux";
			compression = "none";
			load = <0x8000>;
			entry = <0x8000>;
			hash@1 {
				algo = "md5";
			};
		};
		ramdisk@1 {
			description = "Ramdisk";
			data = /incbin/("rootfs.cpio.xz");
			type = "ramdisk";
			arch = "arm";
			os = "linux";
			compression = "none";
			hash@1 {
				algo = "md5";
			};
		};

	};

	configurations {
		/*
		 * U-Boot's adi_hwref command (cmd/adi_hwref.c) reads the Zynq XADC
		 * Vp/Vn pins unconditionally at every boot (called from qspiboot)
		 * and sets fit_config to config@<0..9> based on a hardware-revision
		 * voltage divider that real ADI Pluto/M2k boards have wired but
		 * this board doesn't -- the floating pin here reads back as
		 * revision 1. All configs below are identical aliases pointing at
		 * this board's single fdt/fpga/kernel/ramdisk set, so whatever
		 * index adi_hwref computes still resolves. Confirmed necessary on
		 * real hardware 2026-08-23: trimming this down to just config@0
		 * left the board stuck in "Could not find configuration node".
		 */
		default = "config@0";
		config@0 {
			description = "Linux with fpga RevA";
			fdt = "fdt@1";
			kernel = "linux_kernel@1";
			ramdisk = "ramdisk@1";
			fpga = "fpga@1";
		};
		config@1 {
			description = "Linux with fpga RevB";
			fdt = "fdt@1";
			kernel = "linux_kernel@1";
			ramdisk = "ramdisk@1";
			fpga = "fpga@1";
		};
		config@2 {
			description = "Linux with fpga RevB";
			fdt = "fdt@1";
			kernel = "linux_kernel@1";
			ramdisk = "ramdisk@1";
			fpga = "fpga@1";
		};
		config@3 {
			description = "Linux with fpga RevB";
			fdt = "fdt@1";
			kernel = "linux_kernel@1";
			ramdisk = "ramdisk@1";
			fpga = "fpga@1";
		};
		config@4 {
			description = "Linux with fpga RevB";
			fdt = "fdt@1";
			kernel = "linux_kernel@1";
			ramdisk = "ramdisk@1";
			fpga = "fpga@1";
		};
		config@5 {
			description = "Linux with fpga RevB";
			fdt = "fdt@1";
			kernel = "linux_kernel@1";
			ramdisk = "ramdisk@1";
			fpga = "fpga@1";
		};
		config@6 {
			description = "Linux with fpga RevB";
			fdt = "fdt@1";
			kernel = "linux_kernel@1";
			ramdisk = "ramdisk@1";
			fpga = "fpga@1";
		};
		config@7 {
			description = "Linux with fpga RevB";
			fdt = "fdt@1";
			kernel = "linux_kernel@1";
			ramdisk = "ramdisk@1";
			fpga = "fpga@1";
		};
		config@8 {
			description = "Linux with fpga RevC";
			fdt = "fdt@1";
			kernel = "linux_kernel@1";
			ramdisk = "ramdisk@1";
			fpga = "fpga@1";
		};
		config@9 {
			description = "Linux with fpga maiaplus";
			fdt = "fdt@1";
			kernel = "linux_kernel@1";
			ramdisk = "ramdisk@1";
			fpga = "fpga@1";
		};
	};
};
