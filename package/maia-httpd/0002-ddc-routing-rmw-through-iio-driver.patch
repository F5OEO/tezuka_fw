+    let file = routing_reg_file()?;
+    let old = read_routing_reg(&file)?;
+    let new = if enable { old | ROUTING_BIT } else { old & !ROUTING_BIT };
+    if new != old {
+        std::fs::write(&file, format!("0x{:x} 0x{:x}", PCORE_REG_MAGIC | ROUTING_REG, new))?;
+    }
+    let readback = read_routing_reg(&file)?;
+    if readback != new {
+        anyhow::bail!("DDC routing register reads 0x{readback:x}, expected 0x{new:x}");
