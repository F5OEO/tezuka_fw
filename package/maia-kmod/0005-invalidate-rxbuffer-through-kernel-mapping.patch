@@ -93,18 +97,22 @@ static int maia_sdr_recording_mmap(struct file *file,
 		return ret;
 	}
 
+	// Invalidate the outer (L2) cache first, by physical address, then
+	// L1. This is the order Linux uses after a DMA_FROM_DEVICE transfer:
+	// invalidating L1 first would let a speculative L1 refill fetch stale
+	// L2 lines before L2 is invalidated.
+	arm_cache_outer_inv_range(drvdata->mem_base_addr + offset,
+				  drvdata->mem_base_addr + offset + size);
+
 	// Invalidate ARMv7 L1 cache by virtual address range.
 	//
 	// The L1 data cache is physically indexed and physically tagged, but
-	// invalidation is done using virtual addresses, line by line. We use
-	// the userspace virtual addresses, since the DMA buffer is not mapped
-	// at all in kernel memory.
+	// invalidation is done using virtual addresses, line by line. The
+	// recording region is not mapped in kernel memory, so we use the
+	// userspace mapping created above; it cannot go away while we are
+	// still inside mmap().
 	v7_dma_inv_range(vma->vm_start, vma->vm_end);
 
-	// Invalidate L2 cache by physical address range.
-	arm_cache_outer_inv_range(drvdata->mem_base_addr + offset,
-				  drvdata->mem_base_addr + offset + size);
-
 	return 0;
 }
 
@@ -114,7 +122,6 @@ static void maia_sdr_rxbuffer_vm_close(struct vm_area_struct *vma)
 
 	mutex_lock(&drvdata->lock);
 	drvdata->mmap_done = 0;
-	drvdata->vm_start = 0;
 	mutex_unlock(&drvdata->lock);
 }
 
@@ -141,14 +148,10 @@ static int maia_sdr_rxbuffer_mmap(struct file *file, struct vm_area_struct *vma)
