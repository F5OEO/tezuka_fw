+	// The mmap_done check, remap_pfn_range() and the mmap_done update
+	// must all happen under the same critical section: otherwise two
+	// concurrent mmap() calls can both pass the check and both map the
+	// buffer. remap_pfn_range() can sleep, so this needs a mutex.
 	mutex_lock(&drvdata->lock);
 
 	if (drvdata->mmap_done) {
@@ -166,7 +169,6 @@ static int maia_sdr_rxbuffer_mmap(struct file *file, struct vm_area_struct *vma)
 		return ret;
 	}
 	drvdata->mmap_done = 1;
-	drvdata->vm_start = vma->vm_start;
 	vma->vm_private_data = (void *)drvdata;
 	vma->vm_ops = &maia_sdr_rxbuffer_vm_ops;
 
@@ -180,32 +182,29 @@ maia_sdr_rxbuffer_cacheinv(struct maia_sdr_rxbuffer_drvdata *drvdata,
 			   unsigned num_buffer)
 {
 	unsigned long offset;
-	unsigned long start;
-	int ret = 0;
+	phys_addr_t phys;
+	unsigned long kva;
 
 	if (num_buffer >= drvdata->num_buffers) {
 		return -1;
 	}
-	mutex_lock(&drvdata->lock);
-	if (!drvdata->mmap_done) {
-		ret = -1;
-		goto out_unlock;
-	}
 	offset = drvdata->buffer_size * num_buffer;
-	start = drvdata->vm_start + offset;
-	// See maia_sdr_recording_mmap for how the cache invalidation works.
-	v7_dma_inv_range(start, start + drvdata->buffer_size);
-out_unlock:
-	mutex_unlock(&drvdata->lock);
-	if (ret) {
-		return ret;
-	}
+	phys = drvdata->mem_base_addr + offset;
+	kva = (unsigned long)drvdata->kaddr + offset;
 
-	// mem_base_addr is fixed at probe time, so this call doesn't touch
-	// anything the lock above protects -- keep it outside to shorten the
-	// critical section.
-	start = drvdata->mem_base_addr + offset;
-	arm_cache_outer_inv_range(start, start + drvdata->buffer_size);
+	// Outer (L2) first, by physical address, then L1 by virtual address,
+	// as Linux does after a DMA_FROM_DEVICE transfer.
+	//
+	// L1 is invalidated through the driver's own kernel mapping of the
+	// buffer. The Cortex-A9 L1 data cache is physically indexed and
+	// tagged, so this removes the lines that userspace reads through its
+	// mapping too. The kernel mapping exists for the life of the device,
+	// so this cannot fault, needs no lock against munmap(), and works
+	// whichever process has the buffer mapped. (Using the userspace
+	// address here could hit a mapping that munmap() had already torn
+	// down, and a cache operation on an unmapped address can abort.)
+	arm_cache_outer_inv_range(phys, phys + drvdata->buffer_size);
+	v7_dma_inv_range(kva, kva + drvdata->buffer_size);
 	return 0;
 }
 
@@ -444,6 +443,17 @@ static int maia_sdr_probe_rxbuffer(struct platform_device *pdev)
 	drvdata->mem_base_addr = reserved_mem->base;
 	drvdata->num_buffers = reserved_mem->size / drvdata->buffer_size;
 
+	// The region is no-map reserved memory, so it is not in the linear
+	// map. Map it cacheable, like the userspace mapping, for cache
+	// maintenance.
+	drvdata->kaddr = devm_memremap(&pdev->dev, reserved_mem->base,
+				       reserved_mem->size, MEMREMAP_WB);
+	if (IS_ERR(drvdata->kaddr)) {
+		ret = PTR_ERR(drvdata->kaddr);
+		dev_err(&pdev->dev, "memremap of the buffer failed\n");
+		goto probe_rxbuffer_error;
+	}
+
 	cdev_init(&drvdata->cdev, &rxbuffer_fops);
 	drvdata->cdev.owner = THIS_MODULE;
