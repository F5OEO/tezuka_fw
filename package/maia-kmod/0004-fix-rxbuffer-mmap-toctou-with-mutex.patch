 	}

+	// The mmap_done check, remap_pfn_range() and the mmap_done/vm_start
+	// update must all happen under the same critical section: otherwise
+	// two concurrent mmap() calls (e.g. from two iiod client contexts)
+	// can both pass the check before either sets mmap_done, and both
+	// remap the same DMA buffer, leaving vm_start pointing at whichever
+	// mapping happened to finish last. remap_pfn_range() can sleep, so
+	// this section needs a sleepable lock, not the spinlock previously
+	// used here (which could only cover the non-sleeping cacheinv path).
+	mutex_lock(&drvdata->lock);
+
+	if (drvdata->mmap_done) {
+		// Device is already mapped
+		mutex_unlock(&drvdata->lock);
+		return -EINVAL;
+	}
+
 	ret = remap_pfn_range(vma, vma->vm_start,
 			      (drvdata->mem_base_addr >> PAGE_SHIFT) +
 				      vma->vm_pgoff,
 			      size, vma->vm_page_prot);
