-	unsigned long flags;

-	spin_lock_irqsave(&drvdata->lock, flags);
+	mutex_lock(&drvdata->lock);
 	drvdata->mmap_done = 0;
 	drvdata->vm_start = 0;
-	spin_unlock_irqrestore(&drvdata->lock, flags);
+	mutex_unlock(&drvdata->lock);
 }

